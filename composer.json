{
    "name": "onepix/wordpress-hooks-stub-generator",
    "description": "Generates a JSON representation of the WordPress actions and filters in your code",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "wordpress",
        "static analysis",
        "phpstan",
        "psalm"
    ],
    "authors": [
        {
            "name": "John Blackbourn",
            "homepage": "https://johnblackbourn.com/"
        },
        {
            "name": "Onepix"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
        }
    },
    "bin": [
        "bin/generate-hooks"
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "erusev/parsedown": "1.7.4",
        "nikic/php-parser": "^5.4.0",
        "phpdocumentor/reflection-docblock": "^5.6.1",
        "symfony/console": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4"
    },
    "require-dev": {
        "opis/json-schema": "2.3.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "mikey179/vfsstream": "^v1.6.12"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/johnbillion"
        }
    ],
    "autoload": {
        "psr-4": {
            "Onepix\\WordPressHooksStubGenerator\\": "src/",
            "Onepix\\WordPressHooksStubGenerator\\Tests\\": "tests/"
        }
    },
    "replace": {
        "wp-hooks/generator": "*"
    },
    "scripts": {
        "test:generator": "php bin/generate-hooks --input=./stubs/php --input=./stubs/php-additional --output=./hooks --ignore-hooks='$filter_name'",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --verbose --dry-run",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@test"
        ]
    }
}
